{
  "name": "@devprism/root",
  "description": "Open-Source AI LaTeX writing workspace",
  "version": "1.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bharathvbcr/DevPrism"
  },
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter=@devprism/desktop dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "lint": "bun run biome check",
    "lint:fix": "bun run biome check --write",
    "map": "dev map",
    "map:if-stale": "dev map --if-stale",
    "agents:verify": "node scripts/verify-agent-instructions.js",
    "docs:verify": "node scripts/verify-docs-contract.js",
    "agents:verify:all": "node scripts/verify-agent-instructions.js --all",
    "ci:local": "bun run lint && bun run docs:verify && bun run agents:verify:all && bun run --filter=@devprism/desktop build && bun run --filter=@devprism/desktop test",
    "release": "echo 'To release: git tag v<version> && git push origin v<version>'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "husky": "^9.1.7"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "rollup": ">=4.58.0",
    "serialize-javascript": ">=6.0.3",
    "undici": ">=7.24.0",
    "flatted": ">=3.4.0",
    "hono": ">=4.12.7",
    "ws": ">=8.20.1",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.23",
    "uuid": ">=11.1.1",
    "@babel/core": "^7.29.6",
    "browserslist": "^4.28.7",
    "baseline-browser-mapping": "^2.11.0"
  }
}
